---
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import { SITE, SOCIAL_LINKS } from '../config';
import { PROFILE } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const recent = (await getPosts()).slice(0, SITE.homeRecentPosts);
const initials = PROFILE.name
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => [...w][0])
	.join('')
	.toUpperCase();
---

<BaseLayout bare description={PROFILE.intro[0]}>
	<section class="hero">
		<div class="avatar reveal" style="--d: 0">
			<div class="ring"></div>
			{
				PROFILE.avatar ? (
					<img src={PROFILE.avatar} alt={PROFILE.name} width="132" height="132" />
				) : (
					<span class="initials">{initials}</span>
				)
			}
		</div>

		<p class="hello reveal" style="--d: 1">Hello, I'm</p>
		<h1 class="name gradient-text" style="--d: 2">{PROFILE.name}</h1>
		<p class="role reveal" style="--d: 3">{PROFILE.role}</p>
		{
			PROFILE.location && (
				<p class="location reveal" style="--d: 3">
					<Icon name="pin" size={16} /> {PROFILE.location}
				</p>
			)
		}

		{
			PROFILE.intro.length > 0 && (
				<div class="intro glass reveal" style="--d: 4">
					{PROFILE.intro.map((p) => <p>{p}</p>)}
				</div>
			)
		}

		{
			SOCIAL_LINKS.length > 0 && (
				<ul class="socials reveal" style="--d: 5">
					{SOCIAL_LINKS.map((link) => (
						<li>
							<a
								class="glass social"
								href={link.href}
								rel={link.href.startsWith('http') ? 'me noopener' : undefined}
							>
								<Icon name={link.icon} size={18} />
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<section class="hobbies" aria-labelledby="hobbies-title">
		<h2 id="hobbies-title" class="section-title">Things I enjoy</h2>
		<ul class="hobby-grid">
			{
				PROFILE.hobbies.map((h, i) => (
					<li class="glass hobby-card reveal-on-scroll" style={`--i: ${i}`}>
						<span class="hobby-icon">
							<Icon name={h.icon} size={22} />
						</span>
						<h3>{h.title}</h3>
						<p>{h.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	{
		recent.length > 0 && (
			<section class="recent" aria-labelledby="recent-title">
				<div class="section-head">
					<h2 id="recent-title" class="section-title">Latest writing</h2>
					<a href="/blog/">
						All posts <Icon name="arrow" size={16} />
					</a>
				</div>
				<div class="glass panel">
					<PostList posts={recent} />
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 3rem 0 4.5rem;
	}

	.avatar {
		position: relative;
		width: 132px;
		height: 132px;
		margin-bottom: 1.6rem;
	}
	.ring {
		position: absolute;
		inset: -5px;
		border-radius: 50%;
		background: conic-gradient(from 0deg, #6366f1, #a855f7, #ec4899, #22d3ee, #6366f1);
		animation: spin 8s linear infinite;
		filter: drop-shadow(0 0 18px rgba(139, 92, 246, 0.45));
	}
	.avatar img,
	.initials {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		border: 4px solid var(--bg);
		object-fit: cover;
		background: var(--surface-strong);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
	}
	.initials {
		font-size: 2.6rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--accent);
	}

	.hello {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--fg-soft);
		opacity: 0.85;
	}
	.name {
		margin: 0.3rem 0 0.5rem;
		font-size: clamp(2.6rem, 9vw, 4.6rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.03em;
		animation:
			reveal 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both,
			shimmer 8s ease-in-out infinite alternate;
		animation-delay: calc(var(--d) * 90ms), 0s;
	}
	.role {
		margin: 0;
		font-size: clamp(1.05rem, 2.6vw, 1.25rem);
		color: var(--fg-soft);
	}
	.location {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0.6rem 0 0;
		font-size: 0.92rem;
		color: var(--muted);
	}

	.intro {
		max-width: 40rem;
		margin-top: 2.2rem;
		padding: 1.4rem 1.8rem;
		text-align: left;
		font-size: 1.08rem;
		color: var(--fg-soft);
	}
	.intro p {
		margin: 0;
	}
	.intro p + p {
		margin-top: 0.8rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		list-style: none;
		margin: 1.8rem 0 0;
		padding: 0;
	}
	.social {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		color: var(--fg);
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.social:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		color: var(--accent);
	}

	/* ---------- Sections ---------- */
	.section-title {
		margin: 0 0 1.4rem;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		text-align: center;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}
	.section-head .section-title {
		text-align: left;
	}
	.section-head a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.92rem;
		text-decoration: none;
	}

	/* ---------- Hobbies ---------- */
	.hobby-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.hobby-card {
		position: relative;
		overflow: hidden;
		padding: 1.5rem 1.4rem 1.4rem;
		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	/* Spotlight that follows the pointer (position set by the script below). */
	.hobby-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(
			320px circle at var(--mx, 50%) var(--my, -40%),
			var(--accent-soft),
			transparent 60%
		);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	.hobby-card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}
	.hobby-card:hover::before {
		opacity: 1;
	}
	.hobby-icon {
		display: inline-grid;
		place-items: center;
		width: 2.8rem;
		height: 2.8rem;
		margin-bottom: 0.9rem;
		border-radius: 12px;
		color: #fff;
		background: linear-gradient(135deg, #6366f1, #a855f7 55%, #ec4899);
		box-shadow: 0 6px 18px rgba(124, 58, 237, 0.35);
	}
	.hobby-card h3 {
		margin: 0 0 0.3rem;
		font-size: 1.12rem;
	}
	.hobby-card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--fg-soft);
	}

	.recent {
		margin-top: 4.5rem;
	}

	/* ---------- Motion ---------- */
	.reveal {
		animation: reveal 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: calc(var(--d) * 90ms);
	}
	/* Only hidden when JS is running (class set in BaseHead), so no-JS visitors still see them. */
	:global(html.js) .reveal-on-scroll {
		opacity: 0;
		transform: translateY(18px);
	}
	.reveal-on-scroll {
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
			border-color 0.25s ease;
		transition-delay: calc(var(--i) * 70ms), calc(var(--i) * 70ms), 0s;
	}
	:global(html.js) .reveal-on-scroll.visible {
		opacity: 1;
		transform: none;
	}
	.reveal-on-scroll.visible:hover {
		transform: translateY(-4px);
		transition-delay: 0s;
	}
	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes shimmer {
		from {
			background-position: 0% center;
		}
		to {
			background-position: 100% center;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html.js) .reveal-on-scroll {
			opacity: 1;
			transform: none;
		}
	}
	@media (max-width: 640px) {
		.hero {
			padding: 1.5rem 0 3.5rem;
		}
		.intro {
			padding: 1.2rem 1.2rem;
			font-size: 1rem;
		}
	}
</style>

<script>
	// Fade hobby cards in as they scroll into view.
	const cards = document.querySelectorAll<HTMLElement>('.reveal-on-scroll');
	if ('IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						e.target.classList.add('visible');
						io.unobserve(e.target);
					}
				}
			},
			{ threshold: 0.15 },
		);
		cards.forEach((c) => io.observe(c));
	} else {
		cards.forEach((c) => c.classList.add('visible'));
	}

	// Pointer-following spotlight on hobby cards.
	document.querySelectorAll<HTMLElement>('.hobby-card').forEach((card) => {
		card.addEventListener('pointermove', (e) => {
			const r = card.getBoundingClientRect();
			card.style.setProperty('--mx', `${e.clientX - r.left}px`);
			card.style.setProperty('--my', `${e.clientY - r.top}px`);
		});
	});
</script>
