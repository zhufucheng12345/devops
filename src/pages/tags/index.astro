---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../utils/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="Tags" description="Browse posts by topic.">
	<h1 class="page-title">Tags</h1>
	<p class="page-subtitle">Browse posts by topic.</p>
	{
		tags.length > 0 ? (
			<ul class="tag-cloud">
				{tags.map((tag) => (
					<li>
						<a class="tag" href={`/tags/${tag.slug}/`}>
							{tag.name} <span class="count">{tag.count}</span>
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="muted">No tags yet.</p>
		)
	}
</BaseLayout>

<style>
	.tag-cloud {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.tag {
		font-size: 0.95rem;
		padding: 0.25rem 0.85rem;
	}
	.count {
		opacity: 0.7;
		font-size: 0.8em;
		margin-left: 0.15rem;
	}
</style>
