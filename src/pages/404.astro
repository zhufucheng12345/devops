---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
	<section class="not-found">
		<p class="code">404</p>
		<h1>Page not found</h1>
		<p class="muted">The page you're looking for doesn't exist or has moved.</p>
		<p>
			<a href="/">Go home</a> · <a href="/blog/">Browse posts</a> · <a href="/search/">Search</a>
		</p>
	</section>
</BaseLayout>

<style>
	.not-found {
		text-align: center;
		padding: 4rem 0;
	}
	.code {
		font-size: 4.5rem;
		font-weight: 800;
		margin: 0;
		line-height: 1;
		color: var(--accent);
	}
	h1 {
		margin: 0.8rem 0 0.4rem;
	}
</style>
