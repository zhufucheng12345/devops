---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { type Post, postUrl, readingTime, tagUrl } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev?: Post;
	next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
	title={title}
	description={description}
	image={cover?.src}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	noindex={draft}
>
	<article class="post">
		<header class="post-header">
			{draft && <p class="draft-banner">Draft — not included in production builds.</p>}
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">·</span>
				<span>{readingTime(post.body)} min read</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								Updated <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</p>
			{
				tags.length > 0 && (
					<p class="tags">
						{tags.map((tag) => (
							<a class="tag" href={tagUrl(tag)}>
								{tag}
							</a>
						))}
					</p>
				)
			}
		</header>

		{
			cover && (
				<Image
					class="cover"
					src={cover}
					alt={coverAlt}
					widths={[720, 1440]}
					sizes="(max-width: 768px) 100vw, 736px"
					loading="eager"
				/>
			)
		}

		{
			toc.length >= 3 && (
				<details class="toc" open>
					<summary>Contents</summary>
					<ol>
						{toc.map((h) => (
							<li class={`depth-${h.depth}`}>
								<a href={`#${h.slug}`}>{h.text}</a>
							</li>
						))}
					</ol>
				</details>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	{
		(prev || next) && (
			<nav class="post-nav" aria-label="More posts">
				{prev ? (
					<a href={postUrl(prev)} rel="prev">
						<span class="label">← Previous</span>
						<span class="post-title">{prev.data.title}</span>
					</a>
				) : (
					<span />
				)}
				{next ? (
					<a href={postUrl(next)} rel="next" class="next">
						<span class="label">Next →</span>
						<span class="post-title">{next.data.title}</span>
					</a>
				) : (
					<span />
				)}
			</nav>
		)
	}
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 2rem;
	}
	h1 {
		font-size: clamp(1.8rem, 5vw, 2.4rem);
		margin: 0 0 0.6rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 0.8rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
	}
	.draft-banner {
		margin: 0 0 1rem;
		padding: 0.5rem 0.8rem;
		border-radius: 6px;
		background: rgba(245, 158, 11, 0.15);
		color: #b45309;
		font-size: 0.9rem;
	}
	.cover {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 0 2rem;
		border-radius: var(--radius);
	}
	.toc {
		margin: 0 0 2rem;
		padding: 0.8rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-soft);
		font-size: 0.93rem;
	}
	.toc summary {
		cursor: pointer;
		font-weight: 600;
	}
	.toc ol {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
	}
	.toc li {
		margin: 0.2rem 0;
	}
	.toc .depth-3 {
		padding-left: 1.1rem;
	}
	.toc a {
		color: var(--fg-soft);
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--accent);
	}
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.post-nav a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.post-nav a:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow);
	}
	.post-nav .next {
		text-align: right;
	}
	.label {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.post-title {
		color: var(--fg);
		font-weight: 600;
	}
	@media (max-width: 560px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// Wrap every highlighted code block and add a copy button.
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.parentNode?.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-btn';
		button.textContent = 'Copy';
		button.setAttribute('aria-label', 'Copy code to clipboard');
		button.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.innerText ?? pre.innerText;
			try {
				await navigator.clipboard.writeText(code);
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Failed';
			}
			setTimeout(() => (button.textContent = 'Copy'), 1500);
		});
		wrapper.appendChild(button);
	});
</script>
