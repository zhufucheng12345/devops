---
import { NAV_LINKS, SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/blog/' ? path.startsWith('/blog') || path.startsWith('/posts') : path.startsWith(href);
---

<header class="site-header">
	<div class="inner">
		<a class="brand" href="/">{SITE.title}</a>
		<nav aria-label="Main">
			{
				NAV_LINKS.map((link) => (
					<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
			<a class="icon-btn" href="/search/" aria-label="Search" title="Search">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
					<path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</a>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--surface-border);
		background: var(--surface);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.inner {
		max-width: calc(var(--wide) + var(--gutter) * 2);
		margin: 0 auto;
		padding: 0.8rem var(--gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.brand {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--fg);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
	}
	nav > a:not(.icon-btn) {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		padding: 0.3rem 0.6rem;
		border-radius: 6px;
	}
	nav > a:not(.icon-btn):hover {
		color: var(--fg);
		background: var(--accent-soft);
	}
	nav > a[aria-current='page'] {
		color: var(--fg);
		font-weight: 600;
	}
	nav :global(.icon-btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	nav :global(.icon-btn:hover) {
		color: var(--fg);
		background: var(--accent-soft);
	}
	@media (max-width: 520px) {
		.inner {
			gap: 0.4rem;
		}
		nav {
			margin-left: -0.6rem;
		}
	}
</style>
